APP_NAME="Clinic RAG Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- データベース(PostgreSQL 16 + pgvector) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clinic_rag
DB_USERNAME=clinic
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# --- キャッシュ / Redis ---
CACHE_STORE=redis
CACHE_PREFIX=clinic_rag
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- SPA 認証(Sanctum) ---
SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:5173,127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ================================================================
# RAG 関連設定
# ================================================================
# --- 回答生成 ---
# 既定は fake(キー無しで即実行)。本物の回答は anthropic(実API・有料) か ollama(ローカル・無料) を選ぶ。
# LLM_DRIVER: anthropic / ollama / fake
LLM_DRIVER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Embedding(1024次元) ---
# 既定は fake。実運用は voyage(実API) か ollama(ローカル・無料) を選ぶ。
# ※ シードと検索でドライバを揃えること(ベクトル空間が異なると検索精度が劣化するため)。
# EMBEDDING_DRIVER: voyage / ollama / fake
EMBEDDING_DRIVER=fake
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_BASE_URL=https://api.voyageai.com/v1
EMBEDDING_DIMENSIONS=1024

# --- ローカルLLM(Ollama。無料・オフライン)---
# Mac にネイティブ導入した Ollama へ Docker から接続する場合は host.docker.internal を使う。
# 事前に: ollama pull qwen2.5:7b && ollama pull bge-m3
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- 検索・回答パラメータ ---
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.5
RAG_ANSWER_PROMPT_VERSION=v1
RAG_JUDGE_PROMPT_VERSION=v1

# --- キャッシュ戦略(ADR-004) ---
# Phase 1 は単純 TTL のみ。SWR は Phase 3 Step 2 でフラグ ON にして before/after を計測
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=3600
RAG_CACHE_SWR_ENABLED=true
RAG_CACHE_STALE_TTL=86400

# --- 負荷試験用フェイクのレイテンシ(ミリ秒) ---
FAKE_LLM_LATENCY_MS=2000
FAKE_EMBEDDING_LATENCY_MS=100

# --- 取り込み時の楽観ロック検証用フィーチャーフラグ(ADR-005 / 負荷試験 S4) ---
# false にすると楽観ロックを無効化し「対策なし」状態を再現できる
RAG_OPTIMISTIC_LOCK_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
